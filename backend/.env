PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=manager
DB_NAME=restro_db
DB_PORT=3306

# Frontend Origin for CORS
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------
# 📱 SMS GATEWAY CONFIGURATION FOR AUTOMATED MOBILE SMS DELIVERY
# -----------------------------------------------------------------
# Options for SMS_PROVIDER:
#   1. 'mock'     - Default: logs formatted message in terminal & provides 1-click WhatsApp/Device SMS share
#   2. 'fast2sms' - Popular Indian telecom gateway (https://www.fast2sms.com)
#   3. 'twilio'   - Global telecom standard (https://www.twilio.com)

SMS_PROVIDER=mock

# If using Fast2SMS:
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# If using Twilio:
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
